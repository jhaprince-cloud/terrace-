# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Required in production: 32+ random characters (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Payments. Leave STRIPE_SECRET_KEY empty to run in test mode (no real charges, no card data sent to the server).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Protects /api/admin/* (send as x-admin-key header). Leave empty to disable admin routes.
ADMIN_KEY=

DB_FILE=./data/store.db
